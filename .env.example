# Copy this file to .env.local and edit it if your setup differs.
# Both values are optional - without them the defaults below are used.

# Ollama chat endpoint.
REACT_APP_OLLAMA_URL=http://localhost:11434/api/chat

# Model used for rewrites and style analysis.
# Any model pulled in Ollama works, for example llama3.2 or qwen2.5:7b.
REACT_APP_OLLAMA_MODEL=llama3.2
